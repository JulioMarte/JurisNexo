# Live hosted-model test configuration.
# Copy to a local untracked environment file or export in your shell.
# Never commit a real key. GitHub Actions must source the same name from an encrypted secret.

OPENROUTER_API_KEY=

# Optional policy overrides for controlled experiments. Defaults belong in code/config,
# not in secrets. DeepSeek selection should remain cost-first (Flash/cheapest suitable tier).
JURISNEXO_OPENROUTER_JEV_MODEL=~typesafe/jev-latest
JURISNEXO_OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash

# Default production/canary reasoning policy. Use xhigh only in explicit comparison benchmarks.
JURISNEXO_OPENROUTER_DEEPSEEK_REASONING_EFFORT=high

# Structured-output policy for DeepSeek/OpenRouter.
# DeepSeek's native API documents JSON Output via json_object. JurisNexo
# validates the returned object locally against its contract schema. "tool" and
# "json_schema" remain explicit comparison modes for providers that support them.
JURISNEXO_OPENROUTER_DEEPSEEK_STRUCTURED_MODE=json_object

# Optional comma-separated provider priority for reproducible diagnostics.
# Example: DeepSeek,Fireworks. Leave blank for normal routed operation.
JURISNEXO_OPENROUTER_DEEPSEEK_PROVIDER_ORDER=

# For reproducible capability diagnostics, pin one provider and disable fallback.
# Normal routed operation may leave PROVIDER_ORDER blank and fallbacks enabled.
JURISNEXO_OPENROUTER_DEEPSEEK_ALLOW_PROVIDER_FALLBACKS=true
